---
import "@fontsource-variable/figtree"
import "@fontsource/iosevka"
import DownloadIcon from "@lucide/astro/icons/download"
import HeartIcon from "@lucide/astro/icons/heart"
import categories from "../categories.json"
import Category from "../components/Category.astro"
import Cmd from "../components/Cmd.astro"
import Pkg from "../components/Pkg.astro"
import "../styles/index.css"
import "../styles/hljs.css"

// @ts-ignore (deprecated)
import GithubIcon from "@lucide/astro/icons/github"
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/nixite.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="generator" content={Astro.generator} />
        <meta
            name="google-site-verification"
            content="xfK-I2iIJxvbwRBgGpDMfhTXCxJ90ohIMDEqO_eDS_w"
        />
        <!-- Primary Meta Tags -->
        <title>Nixite - installs your linux software</title>
        <meta name="title" content="Nixite - installs your linux software" />
        <meta
            name="description"
            content="Generate bash scripts to install all your Linux software unattendedly. Nixite picks the best installation method, suppresses prompts, and includes an updater for all your packages."
        />
        <meta
            name="keywords"
            content="linux, software installer, package manager, automation, bash script, ubuntu, arch linux, firefox, discord, steam, development tools"
        />
        <meta name="author" content="aspizu" />
        <meta name="robots" content="index, follow" />
        <link rel="canonical" href="https://aspizu.github.io/nixite/" />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="https://aspizu.github.io/nixite/" />
        <meta property="og:title" content="Nixite - installs your linux software" />
        <meta
            property="og:description"
            content="Generate bash scripts to install all your Linux software unattendedly. Nixite picks the best installation method, suppresses prompts, and includes an updater for all your packages."
        />
        <meta
            property="og:image"
            content="https://aspizu.github.io/nixite/og-image.png"
        />
        <meta property="og:site_name" content="Nixite" />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content="https://aspizu.github.io/nixite/" />
        <meta
            property="twitter:title"
            content="Nixite - installs your linux software"
        />
        <meta
            property="twitter:description"
            content="Generate bash scripts to install all your Linux software unattendedly. Nixite picks the best installation method, suppresses prompts, and includes an updater for all your packages."
        />
        <meta
            property="twitter:image"
            content="https://aspizu.github.io/nixite/og-image.png"
        />
        <meta property="twitter:creator" content="@aspizu" />

        <!-- Additional SEO -->
        <meta name="theme-color" content="#ffffff" />
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <meta name="apple-mobile-web-app-status-bar-style" content="default" />
        <meta name="apple-mobile-web-app-title" content="Nixite" />
    </head>

    <body class="flex flex-col bg-black">
        <div
            class="flex flex-col flex-wrap max-h-180 mx-auto p-4 gap-4 overflow-x-scroll"
        >
            {
                categories.map((category) => (
                    <Category name={category.name}>
                        {category.packages.map((pkg) => (
                            <Pkg id={pkg.id} name={pkg.name} default={pkg.default} />
                        ))}
                    </Category>
                ))
            }
        </div>
        <div class="relative flex flex-col w-5xl mx-auto gap-2">
            <p class="text-center text-sm text-neutral-400">
                Download and run <Cmd value="bash ~/Downloads/nixite.sh" /> in your terminal.
                Some installers may prompt for a password.
            </p>

            <div
                class="border-neutral-800 bg-black rounded-xl border-[1.5px] font-mono overflow-hidden"
            >
                <span
                    class="font-sans text-sm flex gap-2 px-2 py-1 bg-neutral-800/50 items-center font-medium text-neutral-300"
                    >~/Downloads/nixite.sh
                    <div
                        class="ml-auto size-3.5 rounded-full bg-green-500 dark:bg-green-400"
                    >
                    </div>
                    <div class="size-3.5 rounded-full bg-yellow-500 dark:bg-yellow-400">
                    </div>
                    <div class="size-3.5 rounded-full bg-red-500 dark:bg-red-400"></div>
                </span>
                <pre><code id="preview" class="language-bash leading-tight" /></pre>
            </div>
        </div>
        <div
            class="fixed bottom-0 inset-x-0 h-64 bg-linear-to-b from-transparent to-black pointer-events-none"
        >
        </div>
        <div class="sticky bottom-0 inset-x-0 py-4">
            <div
                class="flex items-center w-4xl mx-auto border-[1.5px] border-neutral-800 shadow-xl bg-neutral-900 rounded-xl p-1 gap-1"
            >
                <span class="mr-auto text-sm font-semibold">NIXITE</span>
                <span class="mr-auto text-sm font-semibold">A -- toggle selection</span>
                <select
                    class="border-[1.5px] font-medium rounded-lg px-2 py-1 bg-neutral-800 border-neutral-700"
                    id="distro"
                >
                    <option value="ubuntu">Ubuntu Desktop</option>
                    <option value="debian">Debian Stable</option>
                    <option value="fedora">Fedora Workstation</option>
                    <option value="arch">Arch Linux</option>
                </select>
                <button
                    id="install-btn"
                    type="button"
                    class="flex items-center gap-1 px-2 py-1 bg-white hover:bg-white/90 transition-colors text-black rounded-lg"
                >
                    <DownloadIcon class="size-4" />
                    Download
                </button>
            </div>
        </div>
        <script>
            import "../scripts/index.ts"
        </script>
    </body>
</html>
