---
interface Props {
    id: string
    name: string
    default?: boolean
}
const {id, name, default: isDefault} = Astro.props
---

<label
    class="flex items-center hover:bg-white/15 select-none transition-colors has-checked:text-white text-white/80"
>
    <input
        class="pkg-checkbox"
        type="checkbox"
        data-id={id}
        data-default={Boolean(isDefault)}
    />
    <img
        src={`icons/${id}.svg`}
        width={24}
        height={24}
        alt={name}
        onerror="this.src = 'icons/unknown.svg'"
    />
    {name}
    <span class="Badge ml-auto text-sm text-gray-800 font-medium rounded-md px-1.5"
    ></span>
</label>
